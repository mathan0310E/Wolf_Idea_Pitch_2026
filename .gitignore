/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# self-hosted standalone bundle (npm run bundle) - see DEPLOYMENT.md
/dist/
# bundle archives - hundreds of MB, GitHub rejects blobs over 100 MB
/dist*.zip

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
