rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    // NOTE: direct client access is intentionally custom-claim-only. The
    // server APIs additionally authorize the ADMIN_EMAILS allowlist (see
    // lib/admin-auth.ts) and reach Firestore via the Admin SDK, which bypasses
    // these rules. Do NOT hardcode organizer emails here — rules files are
    // deployed and visible; keep PII in ADMIN_EMAILS (.env.local / Vercel).
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Registrations collection
    match /registrations/{registrationId} {
      // Public cannot write directly to registrations (gated via API route)
      allow create, update, delete: if false;
      
      // Admin can read and write all registrations
      allow read, write: if isAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Settings collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Firebase Trigger Email extension queue — server-side only (Admin SDK
    // bypasses rules). Clients must never read or write the mail queue.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Admin 2FA OTP state — server-side only (Admin SDK bypasses rules).
    // Clients must never read or write OTP tokens or verification records.
    match /otp_tokens/{uid} {
      allow read, write: if false;
    }
    match /otp_verified/{uid} {
      allow read, write: if false;
    }

    // Admin profiles
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
