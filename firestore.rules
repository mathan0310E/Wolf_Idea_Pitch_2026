rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Direct client access is custom-claim-only, and even an admin claim
    // cannot delete or rewrite records from the browser. Deletes, backups,
    // and audit logs are written only by the server Admin SDK (which bypasses
    // these rules) after the ADMIN_EMAILS allowlist and email OTP checks.
    // Do NOT hardcode organizer emails here — rules are deployed and visible.
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Registrations: an admin claim may read. Create, update, and delete
    // from the client are removed. Removal goes through the admin API,
    // which copies the record into `backups` before deleting it.
    match /registrations/{registrationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Payment screenshots (Base64) never leave through the client SDK.
    match /payments/{paymentId} {
      allow read, create, update, delete: if false;
    }

    // Only the public event gate is readable. The sequence counter is not.
    match /settings/{docId} {
      allow read: if docId == 'event';
      allow create, update, delete: if false;
    }

    // Audit logs are append-only on the server. Clients cannot read,
    // edit, or delete them.
    match /auditLogs/{logId} {
      allow read, create, update, delete: if false;
    }

    // Deleted-record archives. No client access, including delete.
    match /backups/{backupId} {
      allow read, create, update, delete: if false;
    }
    match /backupScreenshots/{backupId} {
      allow read, create, update, delete: if false;
    }

    match /otp_tokens/{uid} {
      allow read, write: if false;
    }
    match /otp_verified/{uid} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read, create, update, delete: if false;
    }
  }
}
