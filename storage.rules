rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Payment Screenshots
    match /payment-screenshots/{registrationId}/{fileName} {
      // Gated access for admin users
      allow read, write: if isAdmin();
    }
  }
}
