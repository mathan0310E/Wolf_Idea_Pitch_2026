rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Payment Screenshots — direct client uploads are short-lived & scoped.
    // Primary path is POST /api/uploads/screenshot (Admin SDK). This rule
    // allows an authenticated fallback upload if the API path is bypassed.
    match /payment-screenshots/{registrationId}/{fileName} {
      // Authenticated user uploading proof; Admin SDK bypasses rules anyway.
      allow read: if isAdmin();
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
