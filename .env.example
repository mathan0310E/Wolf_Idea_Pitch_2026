# Firebase Public Web Configuration (Client Side)
# Fill these from Firebase Console > Project settings > Your apps > Web app config
NEXT_PUBLIC_FIREBASE_API_KEY="your-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:your-app-id"

# Public site URL (used for SEO metadataBase - set to the Vercel domain)
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Admin authorization: comma-separated Google account emails allowed to sign
# in to the admin panel (Google sign-in only). When set, ONLY these accounts
# can administer the event — enforced server-side on every admin API call.
# Leave empty to fall back to the role:"admin" custom-claim gate
# (node scripts/set-admin-claim.mjs <uid-or-email>).
ADMIN_EMAILS="your-admin-email@gmail.com"

# Firebase Admin SDK Credentials (Server Side ONLY - NEVER commit to git)
# From Firebase Console > Project settings > Service accounts > Generate new private key
# The key must stay on ONE line with literal \n sequences.
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
