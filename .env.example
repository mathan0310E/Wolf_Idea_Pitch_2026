# Firebase Public Web Configuration (Client Side)
# Copy this file to .env.local and fill REAL values from Firebase Console >
# Project settings > Your apps > Web app config. Never commit .env.local.
# (measurementId is optional for JS SDK v7.20.0+ — only needed for Google
# Analytics; set NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID only if you use it.)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
# No STORAGE bucket variable: payment screenshots are sent Base64 in POST /api/registrations/submit
# and stored in a Firestore `payments` document — Firebase Storage is not used.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# Public site URL (used for SEO metadataBase - set to the Vercel domain)
# ⚠️ ORGANIZER: Replace with your actual domain before go-live
# Example: NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Admin authorization: comma-separated emails allowed to sign
# in to the admin panel (Email/Password auth). When set, ONLY these accounts
# can administer the event — enforced server-side on every admin API call.
# Leave empty to fall back to the role:"admin" custom-claim gate
# (node scripts/set-admin-claim.mjs <uid-or-email>).
# ⚠️ ORGANIZER: Add your admin email(s) before go-live.
ADMIN_EMAILS="your-admin-email@gmail.com"

# Firebase Admin SDK Credentials (Server Side ONLY - NEVER commit to git)
# From Firebase Console > Project settings > Service accounts > Generate new private key
# The key must stay on ONE line with literal \n sequences.
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# No SMTP_* variables — admin 2FA OTP email is delivered by the Firebase
# Trigger Email extension (see FIREBASE_SETUP.md §3b): install the extension
# in the Firebase console and configure its sender there. The server queues
# mail by writing to Firestore `mail/{id}`; no credentials live in this repo.

